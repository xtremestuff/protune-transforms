//GoPro GP-Log2 IDT for ACES workflow inside DaVinci Resolve
#if (__RESOLVE_VER_MAJOR__ >= 17)
DEFINE_ACES_PARAM(IS_PARAMETRIC_ACES_TRANSFORM: 0)
#endif

//REC2020 to ACES using CAT02
__CONSTANT__ float r2020[3][3] = { 0.678891f, 0.158868f, 0.162240f}, {0.045571f, 0.860712f, 0.093716f}, {-0.000486f, 0.025060f, 0.975425f }};
__DEVICE__ float protune_to_linear(float xV) {
	return ((_powf(600.0f, xV) - 1.0f) / 599.0f);
}


__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B) {

	p_R = protune_to_linear(p_R);
	p_G = protune_to_linear(p_G);
	p_B = protune_to_linear(p_B);

	float rVal = r2020[0][0] * p_R + r2020[0][1] * p_G + r2020[0][2] * p_B;
	float gVal = r2020[1][0] * p_R + r2020[1][1] * p_G + r2020[1][2] * p_B;
	float bVal = r2020[2][0] * p_R + r2020[2][1] * p_G + r2020[2][2] * p_B;

	return make_float3( rVal, gVal, bVal);
}
